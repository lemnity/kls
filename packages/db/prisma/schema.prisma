generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(200)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  roles       Role[]
  auditEvents AuditEvent[]
  orgUnits    OrgUnit[]
  workshops   Workshop[]
  productions Production[]
  budgets     Budget[]
  workshopTasks WorkshopTask[]
  taskDeadlineChanges TaskDeadlineChange[]
  taskAssignees TaskAssignee[]
  nodeAttachments NodeAttachment[]
  budgetTemplates BudgetTemplate[]

  @@map("tenants")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(320)
  displayName        String              @db.VarChar(200)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  memberships        Membership[]
  passwordCredential PasswordCredential?

  @@map("users")
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  roleId      String?          @map("role_id") @db.Uuid
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role        Role?            @relation("MembershipRole", fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  auditEvents AuditEvent[]
  authSessions AuthSession[]
  managedOrgUnits OrgUnit[] @relation("OrgUnitManager")
  managedWorkshops Workshop[] @relation("WorkshopManager")
  producedProductions Production[] @relation("ProductionProducer")
  employeeProfiles EmployeeProfile[]
  productionHealthEvents ProductionHealthEvent[]
  createdBudgetVersions BudgetVersion[] @relation("BudgetVersionCreatedBy")
  assignedWorkshopTasks WorkshopTask[] @relation("WorkshopTaskAssignee")
  deadlineChangeActions TaskDeadlineChange[] @relation("TaskDeadlineChangeActor")
  taskAssignments TaskAssignee[] @relation("TaskAssigneeMembership")
  uploadedNodeAttachments NodeAttachment[] @relation("NodeAttachmentUploadedBy")

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("memberships")
}

model OrgUnit {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  parentId            String?      @map("parent_id") @db.Uuid
  managerMembershipId String?      @map("manager_membership_id") @db.Uuid
  name                String       @db.VarChar(200)
  type                String       @db.VarChar(100)
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent              OrgUnit?     @relation("OrgUnitParent", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children            OrgUnit[]    @relation("OrgUnitParent")
  manager             Membership?  @relation("OrgUnitManager", fields: [tenantId, managerMembershipId], references: [tenantId, id], onDelete: Restrict)
  workshops           Workshop[]
  employeeAssignments EmployeeProfileOrgUnit[]

  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
  @@map("org_units")
}

model EmployeeProfile {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  membershipId String       @map("membership_id") @db.Uuid
  title        String       @db.VarChar(200)
  isArtist     Boolean      @default(false) @map("is_artist")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  membership   Membership   @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  orgUnits     EmployeeProfileOrgUnit[]

  @@unique([tenantId, membershipId])
  @@unique([tenantId, id])
  @@map("employee_profiles")
}

model EmployeeProfileOrgUnit {
  tenantId          String          @map("tenant_id") @db.Uuid
  employeeProfileId String          @map("employee_profile_id") @db.Uuid
  orgUnitId         String          @map("org_unit_id") @db.Uuid
  employeeProfile   EmployeeProfile @relation(fields: [tenantId, employeeProfileId], references: [tenantId, id], onDelete: Restrict)
  orgUnit           OrgUnit         @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, employeeProfileId, orgUnitId])
  @@index([tenantId, orgUnitId])
  @@map("employee_profile_org_units")
}

model Workshop {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  orgUnitId           String?      @map("org_unit_id") @db.Uuid
  managerMembershipId String?      @map("manager_membership_id") @db.Uuid
  name                String       @db.VarChar(200)
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit             OrgUnit?     @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)
  manager             Membership?  @relation("WorkshopManager", fields: [tenantId, managerMembershipId], references: [tenantId, id], onDelete: Restrict)
  budgetSections      BudgetSection[]
  workshopTasks       WorkshopTask[]
  budgetGraphNodes    BudgetGraphNode[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("workshops")
}

model Production {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  title                String                  @db.VarChar(300)
  status               String                  @db.VarChar(100)
  premiereDate         DateTime?               @map("premiere_date") @db.Date
  producerMembershipId String?                 @map("producer_membership_id") @db.Uuid
  healthStatus         String                  @map("health_status") @db.VarChar(100)
  healthReason         String?                 @map("health_reason") @db.VarChar(1000)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  producer             Membership?             @relation("ProductionProducer", fields: [tenantId, producerMembershipId], references: [tenantId, id], onDelete: Restrict)
  healthEvents         ProductionHealthEvent[]
  budget               Budget?
  workshopTasks        WorkshopTask[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, premiereDate])
  @@map("productions")
}

enum BudgetStatus {
  PRELIMINARY
  DETAILED
  APPROVED
}

model Budget {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  productionId String        @map("production_id") @db.Uuid
  status       BudgetStatus  @default(PRELIMINARY)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  production   Production    @relation(fields: [tenantId, productionId], references: [tenantId, id], onDelete: Restrict)
  versions     BudgetVersion[]

  @@unique([tenantId, productionId])
  @@unique([tenantId, id])
  @@map("budgets")
}

model BudgetVersion {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  budgetId              String          @map("budget_id") @db.Uuid
  revision              Int
  createdAt             DateTime        @default(now()) @map("created_at")
  createdByMembershipId String          @map("created_by_membership_id") @db.Uuid
  budget                Budget          @relation(fields: [tenantId, budgetId], references: [tenantId, id], onDelete: Restrict)
  createdBy             Membership      @relation("BudgetVersionCreatedBy", fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  sections              BudgetSection[]
  graphNodes            BudgetGraphNode[]

  @@unique([tenantId, budgetId, revision])
  @@unique([tenantId, id])
  @@map("budget_versions")
}

model BudgetSection {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  budgetVersionId String        @map("budget_version_id") @db.Uuid
  workshopId      String        @map("workshop_id") @db.Uuid
  title           String        @db.VarChar(200)
  position        Int
  budgetVersion   BudgetVersion @relation(fields: [tenantId, budgetVersionId], references: [tenantId, id], onDelete: Restrict)
  workshop        Workshop      @relation(fields: [tenantId, workshopId], references: [tenantId, id], onDelete: Restrict)
  items           BudgetItem[]

  @@unique([tenantId, id])
  @@index([tenantId, budgetVersionId])
  @@map("budget_sections")
}

model BudgetItem {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  budgetSectionId String        @map("budget_section_id") @db.Uuid
  description     String        @db.VarChar(500)
  quantity        Decimal       @db.Decimal(12, 3)
  unit            String        @db.VarChar(50)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(14, 2)
  total           Decimal       @db.Decimal(14, 2)
  position        Int
  budgetSection   BudgetSection @relation(fields: [tenantId, budgetSectionId], references: [tenantId, id], onDelete: Restrict)
  workshopTask    WorkshopTask?

  @@unique([tenantId, id])
  @@index([tenantId, budgetSectionId])
  @@map("budget_items")
}

model BudgetGraphNode {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  budgetVersionId String            @map("budget_version_id") @db.Uuid
  parentId        String?           @map("parent_id") @db.Uuid
  workshopId      String?           @map("workshop_id") @db.Uuid
  nodeType        String            @map("node_type") @db.VarChar(20)
  title           String            @db.VarChar(200)
  plannedAmount   Decimal           @map("planned_amount") @db.Decimal(14, 2)
  positionX       Decimal           @map("position_x") @db.Decimal(10, 2)
  positionY       Decimal           @map("position_y") @db.Decimal(10, 2)
  width           Decimal           @db.Decimal(10, 2)
  height          Decimal           @db.Decimal(10, 2)
  alternativeGroupId String?        @map("alternative_group_id") @db.Uuid
  isActive        Boolean           @default(true) @map("is_active")
  revision        Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  budgetVersion   BudgetVersion     @relation(fields: [tenantId, budgetVersionId], references: [tenantId, id], onDelete: Restrict)
  parent          BudgetGraphNode?  @relation("BudgetGraphNodeParent", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children        BudgetGraphNode[] @relation("BudgetGraphNodeParent")
  workshop        Workshop?         @relation(fields: [tenantId, workshopId], references: [tenantId, id], onDelete: Restrict)
  tasks           WorkshopTask[]    @relation("WorkshopTaskGraphNode")
  attachments     NodeAttachment[]

  @@unique([tenantId, id])
  @@index([tenantId, budgetVersionId])
  @@index([tenantId, parentId])
  @@index([tenantId, alternativeGroupId])
  @@map("budget_graph_nodes")
}

model BudgetTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(200)
  nodeType      String   @map("node_type") @db.VarChar(20)
  plannedAmount Decimal  @map("planned_amount") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, nodeType])
  @@map("budget_templates")
}

model WorkshopTask {
  id                   String      @id @default(uuid()) @db.Uuid
  tenantId             String      @map("tenant_id") @db.Uuid
  budgetItemId         String?     @map("budget_item_id") @db.Uuid
  graphNodeId          String?     @map("graph_node_id") @db.Uuid
  productionId         String      @map("production_id") @db.Uuid
  workshopId           String      @map("workshop_id") @db.Uuid
  assigneeMembershipId String?     @map("assignee_membership_id") @db.Uuid
  status               String      @db.VarChar(100)
  description          String      @db.VarChar(1000)
  plannedAmount        Decimal?    @map("planned_amount") @db.Decimal(14, 2)
  deadlineAt           DateTime?   @map("deadline_at")
  completedAt          DateTime?   @map("completed_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  budgetItem           BudgetItem? @relation(fields: [tenantId, budgetItemId], references: [tenantId, id], onDelete: Restrict)
  graphNode            BudgetGraphNode? @relation("WorkshopTaskGraphNode", fields: [tenantId, graphNodeId], references: [tenantId, id], onDelete: Restrict)
  production           Production  @relation(fields: [tenantId, productionId], references: [tenantId, id], onDelete: Restrict)
  workshop             Workshop    @relation(fields: [tenantId, workshopId], references: [tenantId, id], onDelete: Restrict)
  assignee             Membership? @relation("WorkshopTaskAssignee", fields: [tenantId, assigneeMembershipId], references: [tenantId, id], onDelete: Restrict)
  deadlineChanges      TaskDeadlineChange[]
  assignees            TaskAssignee[]

  @@unique([tenantId, id])
  @@unique([tenantId, budgetItemId])
  @@index([tenantId, productionId])
  @@index([tenantId, workshopId])
  @@index([tenantId, status])
  @@index([tenantId, graphNodeId])
  @@map("workshop_tasks")
}

model TaskAssignee {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  taskId       String       @map("task_id") @db.Uuid
  membershipId String       @map("membership_id") @db.Uuid
  status       String       @db.VarChar(20)
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  task         WorkshopTask @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: Restrict)
  membership   Membership   @relation("TaskAssigneeMembership", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, taskId, membershipId])
  @@index([tenantId, taskId])
  @@map("task_assignees")
}

model NodeAttachment {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  nodeId                String          @map("node_id") @db.Uuid
  fileName              String          @map("file_name") @db.VarChar(255)
  contentType           String          @map("content_type") @db.VarChar(150)
  sizeBytes             BigInt          @map("size_bytes")
  objectKey             String          @map("object_key") @db.VarChar(500)
  uploadedByMembershipId String         @map("uploaded_by_membership_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at")
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  node                  BudgetGraphNode @relation(fields: [tenantId, nodeId], references: [tenantId, id], onDelete: Restrict)
  uploadedBy            Membership      @relation("NodeAttachmentUploadedBy", fields: [tenantId, uploadedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, nodeId])
  @@map("node_attachments")
}

model TaskDeadlineChange {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  workshopTaskId      String       @map("workshop_task_id") @db.Uuid
  oldDeadlineAt       DateTime?    @map("old_deadline_at")
  newDeadlineAt       DateTime?    @map("new_deadline_at")
  reason              String       @db.VarChar(500)
  actorMembershipId   String       @map("actor_membership_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workshopTask        WorkshopTask @relation(fields: [tenantId, workshopTaskId], references: [tenantId, id], onDelete: Restrict)
  actorMembership     Membership   @relation("TaskDeadlineChangeActor", fields: [tenantId, actorMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, workshopTaskId])
  @@map("task_deadline_changes")
}

model ProductionHealthEvent {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  productionId        String     @map("production_id") @db.Uuid
  actorMembershipId   String     @map("actor_membership_id") @db.Uuid
  healthStatus        String     @map("health_status") @db.VarChar(100)
  reason              String?    @db.VarChar(1000)
  occurredAt          DateTime   @default(now()) @map("occurred_at")
  production          Production @relation(fields: [tenantId, productionId], references: [tenantId, id], onDelete: Restrict)
  actorMembership     Membership @relation(fields: [tenantId, actorMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, productionId, occurredAt])
  @@map("production_health_events")
}

model PasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model AuthSession {
  id           String     @id @default(uuid()) @db.Uuid
  tokenHash    String     @unique @map("token_hash") @db.Char(64)
  membershipId String     @map("membership_id") @db.Uuid
  expiresAt    DateTime   @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([membershipId, expiresAt])
  @@map("auth_sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String           @db.VarChar(100)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]     @relation("MembershipRole")
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  description String           @db.VarChar(500)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditEvent {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  actorMembershipId   String     @map("actor_membership_id") @db.Uuid
  action              String     @db.VarChar(150)
  subjectType         String     @map("subject_type") @db.VarChar(100)
  subjectId           String     @map("subject_id") @db.Uuid
  changes             Json       @default("{}")
  occurredAt          DateTime   @default(now()) @map("occurred_at")
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorMembership     Membership @relation(fields: [tenantId, actorMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, subjectType, subjectId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("audit_events")
}
